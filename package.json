{
  "name": "harbor-savings-loan",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "keygen": "node -e \"const c=require('crypto');console.log('JWT_SECRET='+c.randomBytes(48).toString('hex'));console.log('ENC_KEY='+c.randomBytes(32).toString('hex'))\"",
    "db:check": "node --env-file=.env scripts/check-db.js",
    "db:init": "node --env-file=.env scripts/init-db.js",
    "db:migrate-sqlite": "node --env-file=.env scripts/migrate-sqlite-to-postgres.js"
  },
  "engines": {
    "node": ">=22.x"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
